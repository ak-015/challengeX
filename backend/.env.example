# ---------- Server ----------
PORT=8080
NODE_ENV=development
# Comma-separated browser origins allowed by CORS (no trailing slash). Include the admin site's origin too.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# ---------- Secrets ----------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production while these still hold the placeholders below.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
OTP_SECRET=change-me-to-another-random-string

# ---------- Database (any Postgres: Supabase, Neon, Render, Railway, self-hosted) ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---------- AI (OpenAI-compatible providers) ----------
# Configure at least ONE provider key. Model IDs may be prefixed with their provider:
#   groq:<model> | gemini:<model> | nvidia:<model>
# An unprefixed ID (e.g. "openai/gpt-oss-20b") is treated as an NVIDIA model.
# The pool round-robins across NIM_MODELS and fails over automatically (429 -> cooldown,
# 404 -> disabled, timeout -> next model), so mixing providers gives you multi-provider failover.

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model pools (comma-separated, primary provider first). Example:
#   NIM_MODELS=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,nvidia/nemotron-3-super-120b-a12b
NIM_MODELS=
# Optional stronger pool for the verdict and roadmap; falls back to NIM_MODELS when empty
NIM_VERDICT_MODELS=
NIM_MAX_CONCURRENCY=4
# Set to true only if ALL configured models support response_format={"type":"json_object"}
NIM_USE_RESPONSE_FORMAT=false

# ---------- Search (tavily | brave) ----------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---------- Email (Brevo first, Resend fallback). At least one is required in production ----------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ChallengeX
RESEND_API_KEY=
RESEND_FROM=

# ---------- Cloudinary (avatars and exported reports) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Admin ----------
# Emails seeded as verified admin accounts; seeded admins can never be demoted, suspended or deleted.
ADMIN_EMAILS=
# Used only by `npm run db:seed` to create/update the seeded admins' password hashes. Minimum 8 characters.
ADMIN_PASSWORD=replace-with-a-long-random-secret

# Print OTP codes to the console. Only honoured when NODE_ENV=development.
DEV_LOG_OTP=false

# ---------- OAuth (optional) ----------
# Public URL of the client app: the browser returns here after sign-in. Defaults to the first FRONTEND_ORIGIN.
FRONTEND_URL=http://localhost:5173
# Public URL of THIS API with no trailing slash. Register <API_PUBLIC_URL>/api/auth/oauth/google/callback
# (and .../apple/callback) with the provider. Defaults to FRONTEND_URL, which works locally because the
# Vite dev server proxies /api to this server. Set it explicitly in production.
API_PUBLIC_URL=

# Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer: https://developer.apple.com/account/resources/authkeys/
# Apple requires an https redirect URI, so it cannot be tested on plain http://localhost.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of AuthKey_XXXX.p8; newlines may be written as \n
APPLE_PRIVATE_KEY=
