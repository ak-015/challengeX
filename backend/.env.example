# ---------- Server ----------
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed browser origins (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----------
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
OTP_SECRET=change-me-to-another-random-string

# ---------- Database (universal: ANY Postgres works — Supabase, Neon, Render, Railway, self-hosted) ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---------- AI (OpenAI-compatible providers) ----------
# Configure at least ONE provider key. Model IDs may be prefixed with their provider:
#   groq:<model> | gemini:<model> | nvidia:<model>
# An unprefixed ID (e.g. "openai/gpt-oss-20b") is treated as an NVIDIA model.
# The pool round-robins across NIM_MODELS and fails over automatically (429 -> cooldown,
# 404 -> disabled, timeout -> next model), so mixing providers here gives you multi-provider
# failover: if the primary provider is rate-limiting, the request lands on the next one.

# Groq — https://console.groq.com/keys (fast, good primary)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini — https://aistudio.google.com/apikey (good fallback)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# NVIDIA NIM — https://build.nvidia.com (optional third provider)
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model pools (comma-separated). Put your primary provider first.
# Example multi-provider setup (all verified live: Groq primary, Gemini fallback, NVIDIA safety):
#   NIM_MODELS=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,nvidia/nemotron-3-super-120b-a12b
NIM_MODELS=
# Optional stronger pool for verdict/roadmap; falls back to NIM_MODELS when empty
NIM_VERDICT_MODELS=
NIM_MAX_CONCURRENCY=4
# Set to true only if ALL configured models support response_format={"type":"json_object"}
NIM_USE_RESPONSE_FORMAT=false

# ---------- Search (tavily | brave) ----------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---------- Email (Brevo first, Resend fallback). At least one is required in production ----------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Challenge Create
RESEND_API_KEY=
RESEND_FROM=

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Admin ----------
# Emails seeded as verified admin accounts; seeded admins can never be demoted/suspended/deleted
ADMIN_EMAILS=
# Used only by `npm run db:seed` to create/update seeded admin password hashes; minimum 8 characters.
ADMIN_PASSWORD=replace-with-a-long-random-secret

# Print OTP codes to the console. Only honoured when NODE_ENV=development
DEV_LOG_OTP=false
